# Optional settings for the Windows desktop backend (backend/). JARVIS needs NO API keys.
# Copy to ".env" only if you want to change a default.

# Must be a loopback address. LAN/internet addresses are rejected on purpose.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Allow the Vite development server (http://localhost:5173) to call the API.
JARVIS_ALLOW_DEV_ORIGINS=true
JARVIS_DEV_FRONTEND_PORT=5173

# Leave empty to use backend\data\jarvis.sqlite3
# JARVIS_DB_PATH=

# Optional: full path to RobloxPlayerBeta.exe if Roblox isn't found automatically.
# JARVIS_ROBLOX_PATH=C:\Users\you\AppData\Local\Roblox\Versions\version-xxxx\RobloxPlayerBeta.exe

# Hard time limit for one SymPy math check, in seconds.
JARVIS_MATH_TIMEOUT_SECONDS=4
